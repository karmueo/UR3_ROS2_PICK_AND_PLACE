<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="coke_can">
    <link name="link">
      <inertial>
        <pose>0 0 0.06 0 0 0</pose>
        <mass>0.390</mass>
        <inertia>
          <ixx>0.00055575</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00055575</iyy>
          <iyz>0</iyz>
          <izz>0.0001755</izz>
        </inertia>
      </inertial>
      <!--
        碰撞体：原为 coke_can.dae 三角网格，与 Robotiq 手指 pad 网格产生 trimesh-trimesh
        对，ODE 哈希桶溢出 → 接触点被丢弃 → 抓握不稳 → 运输中罐子滑出。
        替换为解析圆柱体（半径 0.033m，高 0.12m），接触点数量从 N×M 降到 ≤ 8，
        ODE 稳定计算。pose z=0.06 = 以 link 原点（罐底）为基准把圆柱中心抬到半高处。
        视觉侧仍使用 DAE 网格保持外观。
      -->
      <collision name="collision">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.033</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1000000.0</kp>
              <kd>10.0</kd>
              <min_depth>0.002</min_depth>
              <max_vel>0.1</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0.003937 0.0047244 -0.18 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://coke_can/meshes/coke_can.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
